# meshbox: gateway, mapa web y panel Meshtastic (Anexo C, endurecimiento de 13.4).
# Lo instala deploy/install.sh en /etc/systemd/system. Los puertos salen de config.toml
# (modo appliance 80/8081/8082, modo shared 8090/8091/8092; ADR 0004).
[Unit]
Description=meshbox (gateway, mapa web y panel Meshtastic)
After=network-online.target time-sync.target mosquitto.service meshbox-privd.socket meshbox-firstboot.service
Wants=network-online.target mosquitto.service meshbox-privd.socket
# Sin config.toml (por ejemplo, antes del primer arranque) la unidad se saltea en vez de fallar.
ConditionPathExists=/etc/meshbox/config.toml

[Service]
Type=notify
NotifyAccess=main
User=meshbox
Group=meshbox
SupplementaryGroups=dialout
UMask=0027
Environment=PYTHONUNBUFFERED=1
# Temporales grandes (extracto del mapa, respaldos) en la SD: /tmp es tmpfs en RAM.
Environment=TMPDIR=/var/lib/meshbox/tmp
# Migraciones en un proceso aparte, con respaldo previo (ADR 0003); sale 0 si todo está bien.
ExecStartPre=/opt/meshbox/current/.venv/bin/python -m meshbox migrate --config /etc/meshbox/config.toml
ExecStart=/opt/meshbox/current/.venv/bin/python -m meshbox run --config /etc/meshbox/config.toml
Restart=always
RestartSec=5
TimeoutStartSec=180
TimeoutStopSec=30
# La aplicación envía READY=1 al escuchar y WATCHDOG=1 cada 20 s.
WatchdogSec=60

NoNewPrivileges=yes
ProtectSystem=strict
# /run/meshbox lo crea el socket de privd; el "-" evita fallar si todavía no existe.
# No usar RuntimeDirectory=meshbox: al detener este servicio borraría el socket de privd.
ReadWritePaths=/var/lib/meshbox /etc/meshbox -/run/meshbox
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE

# Sin controlador de memoria del cgroup en la Pi Zero 2 W estos límites no se aplican; la
# aplicación tiene su propia guardia de RSS (ADR 0006).
MemoryHigh=200M
MemoryMax=280M

[Install]
WantedBy=multi-user.target
