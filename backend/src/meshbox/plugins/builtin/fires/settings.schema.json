    "refresh_min": {"type": "integer", "title": "Consultar cada (min)", "minimum": 15, "maximum": 720, "default": 30},
    "alert_km": {"type": "number", "title": "Alertar si hay focos a menos de (km) de un nodo fijo (0 = no)", "minimum": 0, "maximum": 100, "default": 0},
