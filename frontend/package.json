{
	"name": "meshbox-frontend",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"description": "Sitio público y panel de meshbox (SvelteKit SPA servida por el backend)",
	"license": "Apache-2.0",
	"packageManager": "pnpm@10.11.0",
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "node scripts/fetch-map-assets.mjs --if-missing && vite build",
		"preview": "vite preview",
		"i18n": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide --strategy localStorage baseLocale --emit-ts-declarations --silent",
		"check": "pnpm i18n && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
		"lint": "pnpm i18n && prettier --check . && eslint .",
		"format": "prettier --write .",
		"test": "pnpm i18n && vitest run",
		"e2e": "playwright test",
		"gen:api": "node scripts/gen-api.mjs",
		"gen:icons": "pwa-assets-generator",
		"fetch:map-assets": "node scripts/fetch-map-assets.mjs",
		"size": "node scripts/measure-bundle.mjs"
	},
	"dependencies": {
		"@fontsource-variable/inter": "^5.3.0",
		"@lucide/svelte": "^1.60.0",
		"@protomaps/basemaps": "^5.7.2",
		"bits-ui": "^2.19.5",
		"maplibre-gl": "^6.15.0",
		"uplot": "^1.6.32",
		"workbox-cacheable-response": "^7.4.1",
		"workbox-core": "^7.4.1",
		"workbox-expiration": "^7.4.1",
		"workbox-precaching": "^7.4.1",
		"workbox-routing": "^7.4.1",
		"workbox-strategies": "^7.4.1",
		"workbox-window": "^7.4.1"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.14.0",
		"@eslint/js": "^10.0.1",
		"@inlang/paraglide-js": "^2.29.1",
		"@inlang/plugin-message-format": "^4.5.4",
		"@internationalized/date": "^3.10.0",
		"@playwright/test": "^1.64.1",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.3",
		"@testing-library/svelte": "^5.4.2",
		"@types/node": "^22.19.0",
		"@vite-pwa/assets-generator": "^1.0.4",
		"@vite-pwa/sveltekit": "^1.1.0",
		"eslint": "^10.13.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.1",
		"globals": "^17.13.0",
		"jsdom": "^30.1.3",
		"openapi-typescript": "^7.13.0",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.7",
		"tailwindcss": "^4.3.3",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.72.0",
		"vite": "^8.3.4",
		"vite-plugin-pwa": "^1.3.0",
		"vitest": "^5.0.5"
	},
	"pnpm": {
		"overrides": {
			"cookie": "^0.7.2"
		},
		"onlyBuiltDependencies": [
			"@tailwindcss/oxide",
			"esbuild",
			"sharp"
		]
	}
}
